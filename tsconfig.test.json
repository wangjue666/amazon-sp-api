{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "types": ["node", "mocha"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist-test",
    "rootDir": ".",
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["test/**/*.ts", "lib/**/*.ts", "index.ts"],
  "exclude": ["node_modules", "dist", "dist-test"]
}
